# PlayBeat Tools - Build-time Environment Configuration
# Note: Public environment variables are embedded into the static bundle during `npm run build`.
# Any changes to these variables require running a fresh build and redeploying.

# ==============================================================================
# PUBLIC CLIENT VARIABLES (Exposed to browser, prefixed with VITE_)
# ==============================================================================

# Canonical site URL used for sitemaps, canonical links, and OpenGraph tags (no trailing slash)
VITE_SITE_URL="https://playbeatdigital.store"
NEXT_PUBLIC_SITE_URL="https://playbeatdigital.store"

# Real contact email address displayed on /contact/ and legal pages.
VITE_CONTACT_EMAIL="admin@playbeatdigital.store"
NEXT_PUBLIC_CONTACT_EMAIL="admin@playbeatdigital.store"

# Supabase Public API Endpoint (Used for Auth and Public Client Requests)
VITE_SUPABASE_URL="https://nsqhllmhnpjftqvxoxsg.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://nsqhllmhnpjftqvxoxsg.supabase.co"

# Supabase Public Anon / Publishable Key (Protected by PostgreSQL Row Level Security)
VITE_SUPABASE_ANON_KEY="sb_publishable_cscpcDi4N4VEFAjhbsDurg_fPaU23UC"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_cscpcDi4N4VEFAjhbsDurg_fPaU23UC"

# Optional Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX).
# Analytics scripts load ONLY if this ID is configured AND the user explicitly clicks "Accept analytics".
VITE_GA_ID=""
NEXT_PUBLIC_GA_ID=""

# Optional Google Search Console verification token (rendered as <meta name="google-site-verification"> when set)
VITE_GSC_VERIFICATION=""
NEXT_PUBLIC_GSC_VERIFICATION=""

# Central Advertising Toggle ("true" or "false", defaults to "false").
# When false, all ad slots (ad-slot-top, ad-slot-mid, ad-slot-bottom) collapse completely with zero blank space.
VITE_ADS_ENABLED="false"
NEXT_PUBLIC_ADS_ENABLED="false"

# AI Studio Runtime Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# ==============================================================================
# SERVER-ONLY VARIABLES (NEVER exposed to browser / client bundles)
# Configure these in Vercel Project Settings -> Environment Variables
# ==============================================================================

# Supabase Service Role Key (Used for privileged server-side operations and cron jobs)
SUPABASE_SERVICE_ROLE_KEY=""

# Vercel Deployment & Publishing Integration
VERCEL_DEPLOY_HOOK=""
VERCEL_TOKEN=""
VERCEL_PROJECT_ID=""

# Google Search Console Read-Only Service Account
GSC_SITE_URL="https://playbeatdigital.store/"
GSC_CLIENT_EMAIL=""
GSC_PRIVATE_KEY=""

# Google Analytics 4 Data API Reporting
GA4_PROPERTY_ID=""
GA4_CLIENT_EMAIL=""
GA4_PRIVATE_KEY=""

# Google PageSpeed Insights API (Optional, for higher quota)
PAGESPEED_API_KEY=""
